{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medspend",
  "keep_vars": true,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  // Phase 6C.3 request notifications: one schedule for every organization. Each run sends due
  // immediate notifications and evaluates which organizations' digests are due in their own
  // local time. Activated only by the normal deployment.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  }
}
